# 12 or 24 word BIP39 phrase for the hot wallet — ALL user deposit addresses derive from this.
# Generate one for dev with `npx bip39` or in an ethers REPL. KEEP THIS SECRET IN PROD.
HOT_WALLET_MNEMONIC="test test test test test test test test test test test junk"

# Optional explicit hot-wallet private key for broadcasting withdrawals. Falls back to m/44'/60'/0'/0/0 if unset.
# HOT_WALLET_PK=0x...

# EVM RPC endpoint for deposit scanning and withdrawals.
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# How many recent blocks /api/wallet/scan sweeps for incoming deposit txs.
SCAN_WINDOW_BLOCKS=500

# Casino credits per 1 ETH deposited.
CREDIT_RATE=100000

# Signed-cookie secret. ROTATE AND REPLACE IN PROD.
SESSION_SECRET="dev-insecure-change-me"
